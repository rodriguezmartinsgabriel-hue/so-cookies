generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider   = "postgresql"
  relationMode = "prisma"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(OPERACIONAL)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales    Sale[]
  cashFlow CashFlow[]
}

enum Role {
  ADMIN
  OPERACIONAL
  VISUALIZADOR
}

model Product {
  id        String   @id @default(cuid())
  name      String
  sku       String   @unique
  category  String
  price     Float
  cost      Float
  margin    Float
  unit      String   @default("un")
  active    Boolean  @default(true)
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]
  saleItems  SaleItem[]
  recipes    Recipe[]
  priceTiers PriceTier[]
  productions Production[]
}

model Ingredient {
  id              String   @id @default(cuid())
  name            String
  stockKg         Float    @default(0)
  minStockKg      Float    @default(0)
  costPerKg       Float
  supplier        String
  lastPurchase    DateTime?
  caloriesPer100g Float?
  proteinPer100g  Float?
  carbsPer100g    Float?
  fatPer100g      Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  recipeItems RecipeItem[]
}

model Recipe {
  id        String   @id @default(cuid())
  name      String
  yield     Int
  yieldUnit String   @default("un")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product?       @relation(fields: [productId], references: [id])
  productId  String?
  ingredients RecipeItem[]
  totalCost  Float          @default(0)
}

model RecipeItem {
  id           String @id @default(cuid())
  qty          Float
  unit         String @default("kg")

  recipe       Recipe     @relation(fields: [recipeId], references: [id])
  recipeId     String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  ingredientId String

  @@unique([recipeId, ingredientId])
}

model PriceTier {
  id        String @id @default(cuid())
  name      String
  minQty    Int
  maxQty    Int?
  price     Float
  createdAt DateTime @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id])
}

model SaleChannel {
  id         String @id @default(cuid())
  name       String
  commission Float  @default(0)

  sales Sale[]
}

model Sale {
  id        String   @id @default(cuid())
  total     Float
  createdAt DateTime @default(now())

  channel   SaleChannel @relation(fields: [channelId], references: [id])
  channelId String
  user      User?       @relation(fields: [userId], references: [id])
  userId    String?
  items     SaleItem[]
}

model SaleItem {
  id       String @id @default(cuid())
  qty      Int
  price    Float

  sale      Sale    @relation(fields: [saleId], references: [id])
  saleId    String
  product   Product @relation(fields: [productId], references: [id])
  productId String
}

model Order {
  id        String      @id @default(cuid())
  channel   String
  customer  String
  total     Float
  status    OrderStatus @default(PENDENTE)
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  items OrderItem[]
}

enum OrderStatus {
  PENDENTE
  CONFIRMADO
  PRODUCAO
  PRONTO
  ENTREGA
  CONCLUIDO
}

model OrderItem {
  id       String @id @default(cuid())
  qty      Int
  price    Float

  order     Order   @relation(fields: [orderId], references: [id])
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
}

model CashFlow {
  id          String      @id @default(cuid())
  type        CashType
  category    String
  description String
  amount      Float
  date        DateTime    @default(now())

  user   User? @relation(fields: [userId], references: [id])
  userId String?
}

enum CashType {
  ENTRADA
  SAIDA
}

model Production {
  id        String   @id @default(cuid())
  batchCode String   @unique
  qty       Int
  startTime DateTime @default(now())
  endTime   DateTime?
  status    String   @default("pendente")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id])
}

model DeliveryCost {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  channel   String
  orderId   String?
  amount    Float
  notes     String?
  createdAt DateTime @default(now())
}
