generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(OPERACIONAL)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales     Sale[]
  cashFlow  CashFlow[]
  documents Document[]

  @@index([email])
  @@index([role])
}

enum Role {
  ADMIN
  OPERACIONAL
  VISUALIZADOR
}

model Product {
  id        String   @id @default(cuid())
  name      String
  sku       String   @unique
  category  String
  price     Float
  cost      Float
  margin    Float
  unit      String   @default("un")
  active    Boolean  @default(true)
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]
  saleItems  SaleItem[]
  recipes    Recipe[]
  priceTiers PriceTier[]
  productions Production[]

  @@index([category])
  @@index([active])
  @@index([name])
}

model Ingredient {
  id              String   @id @default(cuid())
  name            String
  brand           String?
  stockKg         Float    @default(0)
  minStockKg      Float    @default(0)
  costPerKg       Float
  supplier        String
  lastPurchase    DateTime?
  caloriesPer100g Float?
  proteinPer100g  Float?
  carbsPer100g    Float?
  fatPer100g      Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  recipeItems RecipeItem[]

  @@index([name])
  @@index([supplier])
  @@index([stockKg])
}

model Recipe {
  id        String   @id @default(cuid())
  name      String
  yield     Int
  yieldUnit String   @default("un")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId  String?
  ingredients RecipeItem[]
  totalCost  Float          @default(0)

  @@index([name])
}

model RecipeItem {
  id           String @id @default(cuid())
  qty          Float
  unit         String @default("kg")

  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId     String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  ingredientId String

  @@unique([recipeId, ingredientId])
}

model PriceTier {
  id        String @id @default(cuid())
  name      String
  minQty    Int
  maxQty    Int?
  price     Float
  createdAt DateTime @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id])
}

model SaleChannel {
  id         String @id @default(cuid())
  name       String
  commission Float  @default(0)

  sales Sale[]

  @@index([name])
}

model Sale {
  id        String   @id @default(cuid())
  total     Float
  createdAt DateTime @default(now())

  channel   SaleChannel @relation(fields: [channelId], references: [id])
  channelId String
  user      User?       @relation(fields: [userId], references: [id])
  userId    String?
  items     SaleItem[]

  order   Order? @relation(fields: [orderId], references: [id])
  orderId String? @unique

  @@index([channelId])
  @@index([createdAt])
  @@index([userId])
}

model SaleItem {
  id       String @id @default(cuid())
  qty      Int
  price    Float

  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId    String
  product   Product @relation(fields: [productId], references: [id])
  productId String

  @@index([saleId])
  @@index([productId])
}

model Order {
  id        String      @id @default(cuid())
  channel   String
  customer  String
  total     Float
  status    OrderStatus @default(PENDENTE)
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  items OrderItem[]
  sale  Sale?
  deliveryCosts DeliveryCost[]

  @@index([status])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([channel])
}

enum OrderStatus {
  PENDENTE
  CONFIRMADO
  PRODUCAO
  PRONTO
  ENTREGA
  CONCLUIDO
  CANCELADO
}

model OrderItem {
  id       String @id @default(cuid())
  qty      Int
  price    Float

  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String

  @@index([orderId])
  @@index([productId])
}

model CashFlow {
  id          String      @id @default(cuid())
  type        CashType
  category    String
  description String
  amount      Float
  date        DateTime    @default(now())

  user   User? @relation(fields: [userId], references: [id])
  userId String?

  @@index([type])
  @@index([category])
  @@index([date])
}

enum CashType {
  ENTRADA
  SAIDA
}

model Production {
  id        String   @id @default(cuid())
  batchCode String   @unique
  qty       Int
  startTime DateTime @default(now())
  endTime   DateTime?
  status    String   @default("pendente")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([startTime])
  @@index([productId])
}

model DeliveryCost {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  channel   String
  orderId   String?
  amount    Float
  notes     String?
  createdAt DateTime @default(now())

  order Order? @relation(fields: [orderId], references: [id])
}

model Document {
  id          String       @id @default(cuid())
  title       String
  description String?
  category    DocumentCategory
  content     String?
  fileUrl     String?
  tags        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  userId String?
  user   User? @relation(fields: [userId], references: [id])

  @@index([category])
  @@index([userId])
}

enum DocumentCategory {
  FICHA_TECNICA
  MODO_PREPARO
  HIGIENE
  MANIPULACAO
  TREINAMENTO
  OUTROS
}

model Contact {
  id           String                @id @default(cuid())
  name         String
  email        String?
  phone        String?
  type         ContactType           @default(CLIENTE)
  company      String?
  notes        String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  interactions ContactInteraction[]

  @@index([name])
  @@index([type])
}

model ContactInteraction {
  id        String         @id @default(cuid())
  type      InteractionType
  note      String
  createdAt DateTime       @default(now())

  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String

  @@index([contactId])
  @@index([createdAt])
}

enum ContactType {
  CLIENTE
  FORNECEDOR
  LEAD
  OUTRO
}

enum InteractionType {
  NOTA
  LIGACAO
  EMAIL
  WHATSAPP
  VISITA
  OUTRO
}
