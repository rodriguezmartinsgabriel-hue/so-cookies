# Só Cookies — Environment Variables
# Copy this to .env.local and fill in your values

# Banco de Dados (Supabase PostgreSQL)
DATABASE_URL="postgresql://usuario:senha@host:6543/banco?sslmode=require&uselibpqcompat=true&pgbouncer=true"

# Conexão direta (sem pooler) — obrigatória em produção com Prisma
DIRECT_DATABASE_URL="postgresql://usuario:senha@db.seu-projeto.supabase.co:5432/postgres?sslmode=require&uselibpqcompat=true"

# NextAuth v5
NEXTAUTH_SECRET="seu-secret-aqui"
NEXTAUTH_URL="http://localhost:3000"

# Login com Google (clientes) — https://console.cloud.google.com/apis/credentials
# Redirect URI: https://cookiesecafes.com/api/public/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Secret do cookie de cliente (se vazio, usa NEXTAUTH_SECRET)
CUSTOMER_AUTH_SECRET=""

# Criptografia das credenciais de integração (99Food/iFood)
INTEGRATION_KEY="sua-chave-de-integracao-aqui"

# NextAuth — confiar no host de produção (Vercel)
AUTH_TRUST_HOST="true"

# Supabase (opcional para RLS)
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Domínios (subdomínio da loja do cliente + domínio de gestão)
# Se vazios, o app mantém o comportamento único (loja + gestão juntos)
STORE_HOST="cookiesecafes.com"
STAFF_HOST="app.cookiesecafes.com"
